{
  "expo": {
    "name": "Sheet Snap",
    "owner": "plandoer",
    "slug": "sheet-snap",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "sheetsnap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/icons/splash-icon-light.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b7e7e4f-6bcb-4c9e-857d-f1159489a5ba"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
